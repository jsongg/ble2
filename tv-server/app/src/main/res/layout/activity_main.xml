<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101318"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电视遥控服务"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="手机连接同一 WiFi，输入下面地址即可遥控本机"
            android:textColor="#FF8A97A8"
            android:textSize="16sp" />

        <!-- 局域网地址 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FF1A2230"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本机地址（手机端填写这个 IP）"
                android:textColor="#FF8A97A8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="0.0.0.0"
                android:textColor="#FF4CD964"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="端口 8888"
                android:textColor="#FFCCD6E3"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FF1A2230"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无障碍服务：未开启"
                android:textColor="#FFFF6B6B"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="TCP 服务：未监听"
                android:textColor="#FFCCD6E3"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="已连接手机：0"
                android:textColor="#FFCCD6E3"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvKeyChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="按键通道：-"
                android:textColor="#FFCCD6E3"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvLastCmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:text="最近指令：-"
                android:textColor="#FF6E7B8C"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <!-- 用 TextView 而不是 Button：Material Button 自带 backgroundTint，会把我们的 selector 盖掉 -->
            <TextView
                android:id="@+id/btnAccessibility"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="开启无障碍服务"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnOpenSettings"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="系统设置"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="6dp"
            android:text="使用说明：\n1）电视端安装本应用并开启上面的无障碍服务（免 root）。\n2）手机与电视连接同一个 WiFi/热点。\n3）手机端 App 会自动搜索同网段的电视，也可以手动输入上方 IP。\n4）鼠标模式：拖动手机触摸板移动指针，轻点=左键，长按=右键，双指上下滑=滚轮。\n5）按键模式：方向/确认/返回/主页。部分自绘界面对方向键无响应，请改用鼠标模式点击。"
            android:textColor="#FF7D8899"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
